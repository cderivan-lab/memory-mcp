"use strict";

const { expect } = require("chai");
// Mocha globals: it, describe, before, after, etc.

const {
  buildHookConfig,
  hookConfigBody,
  mcpServerDefinition,
  getReleaseTarget,
  releaseUrl,
  workspaceBootstrapCommand,
  workspaceBootstrapSummary,
} = require("../out/utils/lib");
const {
  binaryName,
  checkUpdates,
  extractBinaryFromArchive,
  installLatest,
  installModel,
  MODEL_FILES,
  modelDir,
  modelPathProblem,
  parseLfsPointer,
  prepare,
  releaseAssetName,
  resolveModelDir,
} = require("../out/utils/install_pali");
const { log, normalizeLogLevel, rustLogFilter } = require("../out/utils/logger");

const { tmpdir } = require("node:os");
const { join } = require("node:path");
const { chmodSync } = require("node:fs");
const { mkdir, readFile, stat, writeFile, rm } = require("node:fs/promises");

const settings = {
  binPath: "/opt/pali bin/pali",
  repoPath: "/tmp/my repo",
  remoteUrl: "https://example.com/mem.git",
  remoteSync: true,
  branch: "trunk",
  scope: "org/team",
};

const token = "ghp_example";

it("hook config wires the three Copilot events", () => {
  const config = buildHookConfig("/ext", settings);

  expect(config.version).to.equal(1);
  expect(Object.keys(config.hooks).sort()).to.deep.equal([
    "agentStop",
    "sessionStart",
    "userPromptTransformed",
  ]);

  for (const [event, entries] of Object.entries(config.hooks)) {
    expect(entries.length).to.equal(1);
    const [entry] = entries;
    expect(entry.type).to.equal("command");
    expect(entry.bash).to.match(/copilot-hooks\.mjs/, event);
    expect(entry.powershell).to.match(/copilot-hooks\.mjs/, event);
    expect(entry.timeoutSec >= 30, event).to.be.ok;
  }
});

it("hook commands carry local settings and never the remote URL", () => {
  const entry = buildHookConfig("/ext", settings).hooks.sessionStart[0];

  expect(entry.bash).to.match(/PALI_BIN='\/opt\/pali bin\/pali'/);
  expect(entry.bash).to.match(/PALI_REPO_PATH='\/tmp\/my repo'/);
  expect(entry.bash).to.match(/PALI_SCOPE='org\/team'/);
  expect(entry.powershell).to.match(/\$env:PALI_SCOPE='org\/team';/);
  expect(entry.bash).to.not.match(/PALI_REMOTE_URL|PALI_BRANCH/);
  expect(entry.powershell).to.not.match(/PALI_REMOTE_URL|PALI_BRANCH/);
});

it("hook commands carry the configured log level", () => {
  const entry = buildHookConfig("/ext", { ...settings, logLevel: "debug" }).hooks.agentStop[0];

  expect(entry.bash).to.match(/PALI_HOOK_LOG_LEVEL='debug'/);
  expect(entry.powershell).to.match(/\$env:PALI_HOOK_LOG_LEVEL='debug';/);

  // An unset level is omitted, leaving the hooks on their own default.
  const bare = buildHookConfig("/ext", settings).hooks.agentStop[0];
  expect(bare.bash).to.not.match(/PALI_HOOK_LOG_LEVEL/);
  expect(bare.powershell).to.not.match(/PALI_HOOK_LOG_LEVEL/);
});

it("hook commands exit quietly when the extension directory is gone", () => {
  // Regression: a hook file left behind by uninstall or an update pointed at a
  // directory VS Code had deleted, so node failed to load the entry point and
  // every event crashed with MODULE_NOT_FOUND.
  const entry = buildHookConfig("/ext", settings).hooks.sessionStart[0];

  expect(
    entry.bash).to.match(/^\[ -f '\/ext\/hooks\/copilot-hooks\.mjs' \] \|\| exit 0; PALI_BIN=/,
      "bash must skip the hook when the script is missing",
    );
  expect(
    entry.powershell).to.match(/^if \(-not \(Test-Path -LiteralPath '\/ext\/hooks\/copilot-hooks\.mjs'\)\) \{ exit 0 \}; \$env:PALI_BIN=/,
      "PowerShell must skip the hook when the script is missing",
    );

  // A present script still runs the same event mode.
  expect(entry.bash).to.match(/copilot-hooks\.mjs' session-start$/);
  expect(entry.powershell).to.match(/copilot-hooks\.mjs' session-start$/);

  // The guard must not hide the profile from the hook environment.
  expect(entry.bash).to.match(/PALI_SCOPE='org\/team'/);
});

it("single quotes are escaped per shell", () => {
  const entry = buildHookConfig("/ext", { ...settings, binPath: "pali's bin" }).hooks.agentStop[0];

  expect(entry.bash).to.match(/PALI_BIN='pali'\\''s bin'/);
  expect(entry.powershell).to.match(/\$env:PALI_BIN='pali''s bin';/);
});

it("hook config body is stable parseable JSON", () => {
  const body = hookConfigBody("/ext", settings);
  const parsed = JSON.parse(body);

  expect(body).to.equal(hookConfigBody("/ext"));
  expect(parsed.version).to.equal(1);
  expect(parsed.hooks.agentStop[0].timeoutSec > parsed.hooks.sessionStart[0].timeoutSec).to.be.ok;
});

it("MCP definition points at the configured stdio server", () => {
  expect(mcpServerDefinition(settings)).to.deep.equal({
    label: "Pali Memory",
    command: "/opt/pali bin/pali",
    args: ["serve"],
    env: {
      // The server always runs with ANSI colour off; MCP diagnostics are read
      // as plain text in the output channel.
      NO_COLOR: "1",
      PALI_BRANCH: "trunk",
      PALI_REPO_PATH: "/tmp/my repo",
      PALI_REMOTE_URL: "https://example.com/mem.git",
      PALI_REQUIRE_REMOTE_SYNC: "true",
      PALI_GIT_TOKEN: "ghp_example",
    },
  });
});

it("remoteSync exports PALI_REQUIRE_REMOTE_SYNC only when enabled", () => {
  const on = mcpServerDefinition(settings, token);
  // The clap argument is a value-taking bool: `true`/`false`, not `1`.
  expect(on.env.PALI_REQUIRE_REMOTE_SYNC).to.equal("true");

  const off = mcpServerDefinition({ ...settings, remoteSync: false }, token);
  expect(off.env.PALI_REQUIRE_REMOTE_SYNC).to.equal(undefined);
});

it("MCP definition exports the log level as a scoped RUST_LOG filter", () => {
  const debug = mcpServerDefinition({ ...settings, logLevel: "debug" }, token);
  expect(debug.env.RUST_LOG).to.equal("pali=debug");

  const warn = mcpServerDefinition({ ...settings, logLevel: "warn" }, token);
  expect(warn.env.RUST_LOG).to.equal("pali=warn");

  // No level configured means no RUST_LOG, so the server keeps its own default.
  const bare = mcpServerDefinition(settings, token);
  expect(bare.env.RUST_LOG).to.equal(undefined);
});

it("token is passed only for HTTPS remotes", () => {
  const https = mcpServerDefinition(
    { ...settings, remoteUrl: "https://example.com/mem.git" },
    token,
  );
  expect(https.env.PALI_GIT_TOKEN).to.equal(token);

  const local = mcpServerDefinition({ ...settings, remoteUrl: "/srv/memories.git" }, token);
  expect(local.env.PALI_REMOTE_URL).to.equal("/srv/memories.git");
  expect(local.env.PALI_GIT_TOKEN).to.equal(undefined);
});

// --- Workspace bootstrap ---------------------------------------------------
//
// `Pali: Scan Workspace` and `Pali: Index Workspace` shell out to the CLI's
// bootstrap subcommands. The invocation is pure so the flags and the model
// handoff can be pinned without spawning the binary.

it("scan runs against the workspace folder and needs no model", () => {
  const invocation = workspaceBootstrapCommand("scan", settings, "/work/repo");

  expect(invocation.args).to.deep.equal(["scan", "--workspace", "/work/repo"]);
  expect(invocation.command).to.equal("/opt/pali bin/pali");
  expect(invocation.env.PALI_MODEL_DIR).to.equal(undefined);
  // Scan artifacts default to <workspace>/.pali, so no --artifacts is needed
  // and nothing is written into the memory repository.
  expect(invocation.args.join(" ")).to.not.match(/--artifacts/);
});

it("index hands the embedding model to the CLI", () => {
  const installed = workspaceBootstrapCommand(
    "index",
    { ...settings, modelDir: "/storage/models/bge-small-en-v1.5" },
    "/work/repo",
  );
  expect(installed.args).to.deep.equal(["index", "--workspace", "/work/repo"]);
  expect(installed.env.PALI_MODEL_DIR).to.equal("/storage/models/bge-small-en-v1.5");

  // An explicit pali.modelPath wins, matching the server definition.
  const configured = workspaceBootstrapCommand(
    "index",
    { ...settings, modelPath: "/custom/models", modelDir: "/storage/models/bge-small-en-v1.5" },
    "/work/repo",
  );
  expect(configured.env.PALI_MODEL_DIR).to.equal("/custom/models");
});

it("scan carries blame, size, and memory settings", () => {
  const defaults = workspaceBootstrapCommand(
    "scan",
    { ...settings, scanSaveMemories: true, repoPath: "", scope: "" },
    "/work/repo",
  );
  expect(defaults.args).to.deep.equal([
    "scan",
    "--workspace",
    "/work/repo",
    "--save-memories",
  ]);
  expect(defaults.env.PALI_MODEL_DIR).to.equal(undefined);

  const configured = workspaceBootstrapCommand(
    "scan",
    {
      ...settings,
      scanSaveMemories: true,
      scanBlame: true,
      scanMaxFileBytes: 1048576,
      repoPath: "/memories",
      scope: "my-repo",
    },
    "/work/repo",
  );
  expect(configured.args).to.deep.equal([
    "scan",
    "--workspace",
    "/work/repo",
    "--blame",
    "--max-file-bytes",
    "1048576",
    "--save-memories",
    "--repo-path",
    "/memories",
    "--scope",
    "my-repo",
  ]);

  // With saving off, the memory-repository flags stay out entirely.
  const artifactsOnly = workspaceBootstrapCommand(
    "scan",
    { ...settings, scanSaveMemories: false, repoPath: "/memories", scope: "my-repo" },
    "/work/repo",
  );
  expect(artifactsOnly.args).to.deep.equal(["scan", "--workspace", "/work/repo"]);
});

it("every bootstrap subcommand carries the configured log level", () => {
  for (const kind of ["scan", "index"]) {
    const invocation = workspaceBootstrapCommand(
      kind,
      { ...settings, logLevel: "debug" },
      "/work/repo",
    );
    expect(invocation.env.RUST_LOG).to.equal("pali=debug");
  }
});

it("bootstrap summaries report the artifacts the run produced", () => {
  expect(
    workspaceBootstrapSummary("scan"),
  ).to.equal(JSON.stringify({ files: 12 }));
  expect(
    workspaceBootstrapSummary(
      "index").to.equal(JSON.stringify({ files: 12),
      ),
    "Pali: indexed 40 chunks from 12 files. Index: /w/.pali/index",
  );

  expect(
    workspaceBootstrapSummary(
      "scan").to.equal(JSON.stringify({
        repositories: 1),
      ),
    "Pali: scanned 12 files (3 findings). Insights: /w/.pali/insights.json",
  );

  // A binary that prints something other than JSON must not hide its output.
  expect(workspaceBootstrapSummary("scan").to.equal("plain summary\n"), "plain summary");
});

it("getReleaseTarget maps supported platforms", () => {
  expect(getReleaseTarget("darwin")).to.equal("arm64", "aarch64-apple-darwin");
  expect(getReleaseTarget("darwin")).to.equal("x64", "x86_64-apple-darwin");
  expect(getReleaseTarget("linux")).to.equal("x64", "x86_64-unknown-linux-gnu");
  expect(getReleaseTarget("win32")).to.equal("x64", "x86_64-pc-windows-msvc");
  expect(getReleaseTarget("linux")).to.equal("arm64", null);
});

function makeContext() {
  return { globalStoragePath: join(tmpdir(), "pali-test-storage-" + Date.now()) };
}

it("resolvePaliBinary returns missing when nothing found", async () => {
  const ctx = makeContext();
  await mkdir(ctx.globalStoragePath, { recursive: true });
  try {
    const result = await require("../out/utils/lib").resolvePaliBinary(ctx, {
      binPath: "pali-nonexistent-xyz",
    });
    expect(result.source).to.equal("missing");
    expect(result.path).to.equal(null);
  } finally {
    await rm(ctx.globalStoragePath, { recursive: true, force: true });
  }
});

it("resolvePaliBinary finds configured binPath", async () => {
  const ctx = makeContext();
  const binDir = join(tmpdir(), `pali-test-bin-${Date.now()}`);
  const binPath = join(binDir, binaryName());
  await mkdir(binDir, { recursive: true });
  await writeFile(binPath, "#!/bin/sh\necho hi\n", "utf8");
  chmodSync(binPath, 0o755);
  try {
    const result = await require("../out/utils/lib").resolvePaliBinary(ctx, { binPath });
    expect(result.source).to.equal("configured");
    expect(result.path).to.equal(binPath);
  } finally {
    await rm(binDir, { recursive: true, force: true });
  }
});

it("resolvePaliBinary finds cached binary in globalStorage", async () => {
  const ctx = makeContext();
  const cached = join(ctx.globalStoragePath, binaryName());
  await mkdir(ctx.globalStoragePath, { recursive: true });
  await writeFile(cached, "#!/bin/sh\necho hi\n", "utf8");
  chmodSync(cached, 0o755);
  try {
    const result = await require("../out/utils/lib").resolvePaliBinary(ctx, {
      binPath: "pali-nonexistent-xyz",
    });
    expect(result.source).to.equal("cache");
    expect(result.path).to.equal(cached);
  } finally {
    await rm(ctx.globalStoragePath, { recursive: true, force: true });
  }
});

it("a bundled binary is preferred over PATH and the cache", async () => {
  const ctx = makeContext();
  const extensionRoot = join(tmpdir(), `pali-test-bundle-${Date.now()}`);
  const bundled = join(extensionRoot, "out", "bin", binaryName());
  await mkdir(join(extensionRoot, "out", "bin"), { recursive: true });
  await writeFile(bundled, "#!/bin/sh\necho hi\n", "utf8");
  chmodSync(bundled, 0o755);
  try {
    const resolved = await require("../out/utils/lib").resolvePaliBinary(
      { globalStoragePath: ctx.globalStoragePath, bundledPath: bundled },
      { binPath: "pali-nonexistent-xyz" },
    );
    expect(resolved.source).to.equal("bundled");
    expect(resolved.path).to.equal(bundled);
  } finally {
    await rm(extensionRoot, { recursive: true, force: true });
  }
});

it("releaseUrl defaults to the newest GitHub Enterprise release", () => {
  expect(
    releaseUrl("aarch64-apple-darwin")).to.equal("https://github.com/cderivan/memory-mcp/releases/latest/download/aarch64-apple-darwin.zip");
});

it("releaseAssetName maps each target to the published asset", () => {
  // macOS ships one universal archive used for both arm64 and x64.
  expect(releaseAssetName("aarch64-apple-darwin")).to.equal("aarch64-apple-darwin.zip");
  expect(releaseAssetName("x86_64-apple-darwin")).to.equal("aarch64-apple-darwin.zip");
  // Windows is a zip prefixed with the binary name.
  expect(releaseAssetName("x86_64-pc-windows-msvc")).to.equal("pali.x86_64-pc-windows-msvc.zip");
  // Linux x64 is a tarball.
  expect(releaseAssetName("x86_64-unknown-linux-gnu")).to.equal("x86_64-unknown-linux-gnu.tgz");
});

it("releaseUrl pins a version and keeps the archive layout", () => {
  expect(
    releaseUrl("x86_64-pc-windows-msvc").to.equal("v1.0.0"),
    "https://github.com/cderivan/memory-mcp/releases/v1.0.0/download/pali.x86_64-pc-windows-msvc.zip",
  );
});

it("update checks ask the REST API for the newest release tag", async () => {
  // Regression: the API URL was built from the web host, yielding
  // github.com/api/v3/repos/... — GitHub Enterprise's path, which answers 404
  // on github.com. Every check came back empty, so no update prompt ever fired.
  const storage = join(tmpdir(), `pali-test-update-${Date.now()}`);
  await mkdir(storage, { recursive: true });
  await writeFile(
    join(storage, "maintenance.json"),
    JSON.stringify({ installedVersion: "v1.0.0", checkUpdates: true }),
    "utf8",
  );

  const requests = [];
  const originalFetch = globalThis.fetch;
  globalThis.fetch = async (url, init) => {
    requests.push({ url: String(url), headers: init?.headers ?? {} });
    return new Response(JSON.stringify({ tag_name: "v1.4.0" }), {
      status: 200,
      headers: { "content-type": "application/json" },
    });
  };
  const updates = [];
  const ui = makeInstallUi(storage);
  ui.promptUpdate = async (oldVersion, newVersion) =>
    updates.push([oldVersion, newVersion]);
  try {
    await checkUpdates(true, ui);

    expect(requests.length).to.equal(1);
    expect(
      requests[0].url).to.equal("https://api.github.com/repos/cderivan/memory-mcp/releases/latest");
    expect(requests[0].headers.Authorization).to.equal("Bearer test-token");
    expect(updates).to.deep.equal([["v1.0.0", "v1.4.0"]], "a newer tag is offered to the user");
  } finally {
    globalThis.fetch = originalFetch;
    await rm(storage, { recursive: true, force: true });
  }
});

it("a missing binary is offered for download even when update checks are off", async () => {
  // Regression: the offer used to be gated on `checkUpdates`, so an install
  // with update prompts dismissed could never ask for the binary it needs.
  const storage = join(tmpdir(), `pali-test-prepare-${Date.now()}`);
  await mkdir(storage, { recursive: true });
  const prompts = [];
  const ui = {
    paliPath: "pali-nonexistent-xyz",
    storagePath: storage,
    extensionPath: join(tmpdir(), `pali-test-ext-${Date.now()}`),
    error: (message) => { throw new Error(`unexpected error: ${message}`); },
    info: () => { },
    command: () => { },
    choose: async (prompt) => {
      prompts.push(prompt);
      return "Later";
    },
    slow: (_, promise) => promise,
    progress: (_, __, body) => body(() => { }),
    localize: (message) => message,
    shouldReuse: async () => undefined,
    promptReload: async () => { },
    promptUpdate: async () => { },
  };
  try {
    const result = await prepare(ui, false);

    expect(result.paliPath).to.equal(null);
    expect(result.source).to.equal("missing");
    expect(prompts.length).to.equal(1);
    expect(prompts[0]).to.match(/binary was not found/);
    expect(result.modelDir).to.equal(null);
  } finally {
    await rm(storage, { recursive: true, force: true });
  }
});

it("a usable pali.modelPath suppresses the model download offer", async () => {
  // Regression: activation only looked in extension storage, so a user who
  // provisioned the model through `pali.modelPath` was asked to download it
  // again on every activation.
  const suffix = `${Date.now()}-${Math.random().toString(16).slice(2)}`;
  const storage = join(tmpdir(), `pali-test-configured-storage-${suffix}`);
  const configured = join(tmpdir(), `pali-test-configured-model-${suffix}`);
  await mkdir(configured, { recursive: true });
  for (const name of MODEL_FILES) {
    await writeFile(join(configured, name), "{}\n", "utf8");
  }

  const prompts = [];
  const ui = {
    paliPath: process.execPath,
    storagePath: storage,
    extensionPath: join(tmpdir(), `pali-test-ext-${suffix}`),
    modelPath: configured,
    error: (message) => { throw new Error(`unexpected error: ${message}`); },
    info: () => { },
    command: () => { },
    choose: async (prompt) => {
      prompts.push(prompt);
      return "Later";
    },
    slow: (_, promise) => promise,
    progress: (_, __, body) => body(() => { }),
    localize: (message) => message,
    shouldReuse: async () => undefined,
    promptReload: async () => { },
    promptUpdate: async () => { },
  };

  try {
    const result = await prepare(ui, false);
    expect(result.source).to.equal("configured");
    expect(result.modelDir).to.equal(configured);
    expect(prompts.length).to.equal(0);

    // An unusable path must not suppress the offer: the server cannot start
    // on it, and the extension reports that problem separately.
    ui.modelPath = join(configured, "missing");
    const fallback = await prepare(ui, false);
    expect(fallback.modelDir).to.equal(null);
    expect(prompts.length).to.equal(1);
  } finally {
    await rm(storage, { recursive: true, force: true });
    await rm(configured, { recursive: true, force: true });
  }
});

it("the model is only considered installed when all three files exist", async () => {
  const storage = join(tmpdir(), `pali-test-model-${Date.now()}`);
  const dir = modelDir(storage);
  try {
    await mkdir(dir, { recursive: true });
    await writeFile(join(dir, "config.json"), "{\n}\n", "utf8");
    expect(await resolveModelDir(storage)).to.equal(null);

    await writeFile(join(dir, "tokenizer.json"), "{}\n", "utf8");
    await writeFile(join(dir, "model.safetensors"), "weights", "utf8");
    expect(await resolveModelDir(storage)).to.equal(dir);
  } finally {
    await rm(storage, { recursive: true, force: true });
  }
});

it("an unusable pali.modelPath names what is missing", async () => {
  const root = join(tmpdir(), `pali-test-model-path-${Date.now()}`);
  const dir = join(root, "bge-small-en-v1.5");
  try {
    expect(
      await modelPathProblem(dir)).to.match(/does not exist/,
        "a missing directory is reported",
      );

    const file = join(root, "not-a-dir");
    await mkdir(root, { recursive: true });
    await writeFile(file, "", "utf8");
    expect(await modelPathProblem(file)).to.match(/not a directory/);

    await mkdir(dir, { recursive: true });
    const empty = await modelPathProblem(dir);
    for (const name of MODEL_FILES) {
      expect(empty.includes(name).to.be.ok, `${name} must be reported missing`);
    }

    await writeFile(join(dir, MODEL_FILES[0]), "{}\n", "utf8");
    await writeFile(join(dir, MODEL_FILES[1]), "{}\n", "utf8");
    const partial = await modelPathProblem(dir);
    expect(!partial.includes(MODEL_FILES[0]).to.be.ok, partial);
    expect(partial.includes(MODEL_FILES[2]).to.be.ok, partial);

    await writeFile(join(dir, MODEL_FILES[2]), "weights", "utf8");
    expect(await modelPathProblem(dir)).to.equal(undefined);

    await writeFile(join(dir, MODEL_FILES[2]), "", "utf8");
    expect(
      (await modelPathProblem(dir).to.be.ok).includes(MODEL_FILES[2]),
      "an empty file is not usable",
    );
  } finally {
    await rm(root, { recursive: true, force: true });
  }
});

it("LFS pointers parse, real model files do not", () => {
  const oid = "a".repeat(64);
  const pointer = parseLfsPointer(
    "version https://git-lfs.github.com/spec/v1\n" + `oid sha256:${oid}\n` + "size 133466304\n",
  );
  expect(pointer).to.deep.equal({ oid, size: 133466304 });
  expect(parseLfsPointer('{"hidden_size": 384}')).to.equal(null);
});

it("an installed model is exported to the server as PALI_MODEL_DIR", () => {
  const definition = mcpServerDefinition(
    { ...settings, modelDir: "/storage/models/bge-small-en-v1.5" },
    token,
  );
  expect(definition.env.PALI_MODEL_DIR).to.equal("/storage/models/bge-small-en-v1.5");
});

it("pali.modelPath is exported as PALI_MODEL_DIR and wins over the installed model", () => {
  const configured = mcpServerDefinition(
    { ...settings, modelPath: "/custom/models/bge-small-en-v1.5" },
    token,
  );
  expect(configured.env.PALI_MODEL_DIR).to.equal("/custom/models/bge-small-en-v1.5");

  const both = mcpServerDefinition(
    { ...settings, modelPath: "/custom/models", modelDir: "/storage/models/bge-small-en-v1.5" },
    token,
  );
  expect(both.env.PALI_MODEL_DIR).to.equal("/custom/models");
});

it("hook commands carry the model directory for the hook-spawned server", () => {
  const entry = buildHookConfig(
    "/ext",
    { ...settings, modelPath: "/custom/models", modelDir: "/storage/models/bge-small-en-v1.5" },
  ).hooks.sessionStart[0];
  expect(entry.bash).to.match(/PALI_MODEL_DIR='\/custom\/models'/);
  expect(entry.powershell).to.match(/\$env:PALI_MODEL_DIR='\/custom\/models';/);

  // No modelPath: the installed model dir is used instead.
  const installed = buildHookConfig(
    "/ext",
    { ...settings, modelDir: "/storage/models/bge-small-en-v1.5" },
  ).hooks.sessionStart[0];
  expect(installed.bash).to.match(/PALI_MODEL_DIR='\/storage\/models\/bge-small-en-v1\.5'/);

  // Neither set: no variable, so the server falls back to its own resolution.
  const bare = buildHookConfig("/ext", settings).hooks.sessionStart[0];
  expect(bare.bash).to.not.match(/PALI_MODEL_DIR/);
  expect(bare.powershell).to.not.match(/PALI_MODEL_DIR/);
});

it("no token means no credential variable, even for HTTPS", () => {
  const https = mcpServerDefinition({ ...settings, remoteUrl: "https://example.com/mem.git" });
  expect(https.env.PALI_GIT_TOKEN).to.equal(undefined);
});

