// --- Logging ---------------------------------------------------------------
//
// One `pali.logLevel` setting drives the extension logger, the MCP server
// (RUST_LOG), and the hooks (PALI_HOOK_LOG_LEVEL). These tests pin the level
// filtering and the filter mapping.

it("normalizeLogLevel falls back to info for unknown values", () => {
  expect(normalizeLogLevel("debug")).to.equal("debug");
  expect(normalizeLogLevel("INFO")).to.equal("info");
  expect(normalizeLogLevel("off")).to.equal("off");
  expect(normalizeLogLevel(undefined)).to.equal("info");
  expect(normalizeLogLevel("verbose")).to.equal("info");
});

it("rustLogFilter scopes the filter to the pali crate", () => {
  expect(rustLogFilter("debug")).to.equal("pali=debug");
  expect(rustLogFilter("info")).to.equal("pali=info");
  expect(rustLogFilter("warn")).to.equal("pali=warn");
  expect(rustLogFilter("error")).to.equal("pali=error");
  expect(rustLogFilter("off")).to.equal("off");
});

it("the logger filters below the configured level", () => {
  const lines = [];
  const originalSink = log.setSink((line) => lines.push(line));
  try {
    log.setLevel("warn");
    log.debug("hidden");
    log.info("hidden");
    log.warn("shown");
    log.error("shown");
    expect(lines.length).to.equal(2);
    expect(lines[0]).to.match(/WARN.*shown/);
    expect(lines[1]).to.match(/ERROR.*shown/);

    log.setLevel("off");
    log.error("hidden");
    expect(lines.length).to.equal(2);

    log.setLevel("debug");
    log.debug("shown");
    expect(lines.length).to.equal(3);
    expect(lines[2]).to.match(/DEBUG.*shown/);
  } finally {
    // Restore the module defaults so other tests see a clean logger.
    log.setLevel("info");
    log.setSink(originalSink);
  }
});

// --- Release downloads -----------------------------------------------------
//
// The binary and the model both come from the project's GitHub Enterprise
// releases. These tests stub `fetch` with in-memory ZIP archives so the full
// download path (auth header, progress, extraction, cleanup) runs without
// network access.

/** Build a minimal stored (uncompressed) ZIP archive from name/data pairs. */
function zipArchive(entries) {
  const { crc32 } = require("node:zlib");
  const parts = [];
  const central = [];
  let offset = 0;
  for (const { name, data } of entries) {
    const nameBuf = Buffer.from(name, "utf8");
    const crc = crc32(data);
    const local = Buffer.alloc(30);
    local.writeUInt32LE(0x04034b50, 0);
    local.writeUInt16LE(20, 4);
    local.writeUInt16LE(0, 6);
    local.writeUInt16LE(0, 8); // method: stored
    local.writeUInt16LE(0, 10);
    local.writeUInt16LE(0x21, 12);
    local.writeUInt32LE(crc, 14);
    local.writeUInt32LE(data.length, 18);
    local.writeUInt32LE(data.length, 22);
    local.writeUInt16LE(nameBuf.length, 26);
    local.writeUInt16LE(0, 28);
    parts.push(local, nameBuf, data);

    const cd = Buffer.alloc(46);
    cd.writeUInt32LE(0x02014b50, 0);
    cd.writeUInt16LE(20, 4);
    cd.writeUInt16LE(20, 6);
    cd.writeUInt16LE(0, 8);
    cd.writeUInt16LE(0, 10);
    cd.writeUInt16LE(0, 12);
    cd.writeUInt16LE(0x21, 14);
    cd.writeUInt32LE(crc, 16);
    cd.writeUInt32LE(data.length, 20);
    cd.writeUInt32LE(data.length, 24);
    cd.writeUInt16LE(nameBuf.length, 28);
    cd.writeUInt16LE(0, 30);
    cd.writeUInt16LE(0, 32);
    cd.writeUInt16LE(0, 34);
    cd.writeUInt16LE(0, 36);
    cd.writeUInt32LE(0, 38);
    cd.writeUInt32LE(offset, 42);
    central.push(cd, nameBuf);
    offset += local.length + nameBuf.length + data.length;
  }
  const cdBuf = Buffer.concat(central);
  const eocd = Buffer.alloc(22);
  eocd.writeUInt32LE(0x06054b50, 0);
  eocd.writeUInt16LE(0, 4);
  eocd.writeUInt16LE(0, 6);
  eocd.writeUInt16LE(entries.length, 8);
  eocd.writeUInt16LE(entries.length, 10);
  eocd.writeUInt32LE(cdBuf.length, 12);
  eocd.writeUInt32LE(offset, 16);
  eocd.writeUInt16LE(0, 20);
  return Buffer.concat([...parts, cdBuf, eocd]);
}

/** Build a gzip-compressed tar archive from name/data pairs (stored entries). */
function tarGzArchive(entries) {
  const { gzipSync } = require("node:zlib");
  const blocks = [];
  for (const { name, data } of entries) {
    const header = Buffer.alloc(512);
    header.write(name, 0, "utf8");
    header.write("0000644\0", 100, "ascii");
    header.write("0000000\0", 108, "ascii");
    header.write("0000000\0", 116, "ascii");
    header.write(data.length.toString(8).padStart(11, "0") + "\0", 124, "ascii");
    header.write(
      Math.floor(Date.now() / 1000)
        .toString(8)
        .padStart(11, "0") + "\0",
      136,
      "ascii",
    );
    header.write("0000000\0", 148, "ascii");
    header.write("0", 156, "ascii"); // typeflag: regular file
    header.write("ustar\0", 257, "ascii");
    header.write("00", 263, "ascii");
    blocks.push(header, data, Buffer.alloc(Math.ceil(data.length / 512) * 512 - data.length));
  }
  blocks.push(Buffer.alloc(1024)); // end-of-archive marker
  return gzipSync(Buffer.concat(blocks));
}

/** A UI double that records every callback the install library invokes. */
function makeInstallUi(storage, { token = "test-token", modelAnswer = "Later" } = {}) {
  const calls = { errors: [], infos: [], reloads: [], prompts: [], progress: [] };
  return {
    paliPath: "pali-nonexistent-xyz",
    storagePath: storage,
    extensionPath: join(tmpdir(), `pali-test-ext-${Date.now()}`),
    getToken: async () => token,
    error: (message) => calls.errors.push(message),
    info: (message) => calls.infos.push(message),
    command: () => { },
    choose: async (prompt) => {
      calls.prompts.push(prompt);
      return modelAnswer;
    },
    slow: (_, promise) => promise,
    progress: (_, __, body) => body((fraction) => calls.progress.push(fraction)),
    localize: (message) => message,
    shouldReuse: async () => undefined,
    promptReload: async (message) => calls.reloads.push(message),
    promptUpdate: async () => { },
    calls,
  };
}

const latestReleaseApiUrl = "https://api.github.com/repos/cderivan/memory-mcp/releases/latest";

function latestReleaseResponse(name, assetUrl) {
  return new Response(
    JSON.stringify({ tag_name: "v1.0.0", assets: [{ name, url: assetUrl }] }),
    { status: 200, headers: { "content-type": "application/json" } },
  );
}

it("installLatest reports a latest-release API failure instead of a missing asset", async () => {
  const storage = join(tmpdir(), `pali-test-release-api-error-${Date.now()}`);
  await mkdir(storage, { recursive: true });
  const originalFetch = globalThis.fetch;
  const requests = [];
  globalThis.fetch = async (url) => {
    requests.push(String(url));
    return new Response("temporarily unavailable", {
      status: 503,
      statusText: "Service Unavailable",
    });
  };
  const ui = makeInstallUi(storage);
  try {
    await expect(() => installLait(ui)).to.be.rejectedWith((error) => {
      expect(error.message).to.match(/release API lookup failed/i);
      expect(error.message).to.match(/503/);
      expect(error.message).to.not.match(/Could not find the .* asset/);
      return true;
    }, "a failed release lookup must not be reported as a missing asset");
    expect(requests).to.deep.equal([latestReleaseApiUrl]);
  } finally {
    globalThis.fetch = originalFetch;
    await rm(storage, { recursive: true, force: true });
  }
});

it("installLatest downloads the release asset through the authenticated API and completes setup", async () => {
  const storage = join(tmpdir(), `pali-test-dl-${Date.now()}`);
  await mkdir(storage, { recursive: true });
  const target = require("../out/utils/install_pali").getReleaseTarget(
    process.platform,
    process.arch,
  );
  expect(target, "tests must run on a platform with a prebuilt binary").to.be.ok;
  const binName = binaryName();
  const payload = Buffer.from("#!/bin/sh\necho pali 1.0.0\n");
  const zip = zipArchive([{ name: binName, data: payload }]);
  const assetUrl = "https://api.github.com/repos/cderivan/memory-mcp/releases/assets/711664240";

  const requests = [];
  const originalFetch = globalThis.fetch;
  globalThis.fetch = async (url, init) => {
    const href = String(url);
    requests.push({ url: href, headers: init?.headers ?? {} });
    if (href === latestReleaseApiUrl) {
      return latestReleaseResponse(releaseAssetName(target), assetUrl);
    }
    expect(href).to.equal(assetUrl);
    return new Response(zip, {
      status: 200,
      headers: { "content-length": String(zip.length) },
    });
  };
  const ui = makeInstallUi(storage);
  try {
    await installLait(ui);

    expect(requests.length).to.equal(2);
    expect(
      requests[0].url).to.equal(latestReleaseApiUrl);
    expect(requests[0].headers.Authorization).to.equal("Bearer test-token");
    expect(requests[1].url).to.equal(assetUrl);
    expect(requests[1].headers.Authorization).to.equal("Bearer test-token");
    expect(requests[1].headers.Accept).to.equal("application/octet-stream");

    const installed = join(storage, binName);
    expect(await readFile(installed)).to.deep.equal(payload);
    expect(ui.paliPath).to.equal(installed);
    expect(
      await stat(join(storage).to.equal(releaseAssetName(target))).then(
        () => "exists",
        () => "gone",
      ),
      "gone",
      "the archive is removed after extraction",
    );
    const maintenance = JSON.parse(await readFile(join(storage, "maintenance.json"), "utf8"));
    expect(maintenance.checkUpdates).to.equal(true);
    expect(maintenance.installedVersion).to.equal("1.0.0");
    expect(ui.calls.reloads.length).to.equal(1);
    expect(ui.paliPath).to.equal(installed);
    expect(ui.calls.prompts.length).to.equal(1);
    expect(ui.calls.progress.length > 0, "download progress is reported").to.be.ok;
  } finally {
    globalThis.fetch = originalFetch;
    await rm(storage, { recursive: true, force: true });
  }
});

it("installLatest requests the release asset directly through the API", async () => {
  // Regression: private repositories require the token-authenticated asset API;
  // a request to the browser download URL cannot carry the credential.
  const storage = join(tmpdir(), `pali-test-dl-api-${Date.now()}`);
  await mkdir(storage, { recursive: true });
  const target = require("../out/utils/install_pali").getReleaseTarget(
    process.platform,
    process.arch,
  );
  expect(target, "tests must run on a platform with a prebuilt binary").to.be.ok;
  const name = releaseAssetName(target);
  const payload = Buffer.from("#!/bin/sh\necho pali 1.0.0\n");
  const zip = zipArchive([{ name: binaryName(), data: payload }]);
  const assetUrl = "https://api.github.com/repos/cderivan/memory-mcp/releases/assets/711664240";

  const requests = [];
  const originalFetch = globalThis.fetch;
  globalThis.fetch = async (url, init) => {
    const href = String(url);
    requests.push({ url: href, headers: init?.headers ?? {} });
    if (href === latestReleaseApiUrl) {
      return latestReleaseResponse(name, assetUrl);
    }
    if (href === assetUrl) {
      return new Response(zip, {
        status: 200,
        headers: { "content-length": String(zip.length) },
      });
    }
    return new Response("unexpected request", { status: 500 });
  };
  const ui = makeInstallUi(storage);
  try {
    await installLait(ui);

    expect(
      requests.map((request) => request.url)).to.deep.equal([latestReleaseApiUrl, assetUrl],
        "the release lookup is followed directly by the asset download",
      );
    expect(requests[1].headers.Authorization).to.equal("Bearer test-token");
    expect(
      requests[1].headers.Accept).to.equal("application/octet-stream");
    expect(await readFile(join(storage).to.deep.equal(binaryName()));
    ), payload);
expect(ui.calls.errors.length).to.equal(0);
expect(ui.calls.reloads.length).to.equal(1);
  } finally {
  globalThis.fetch = originalFetch;
  await rm(storage, { recursive: true, force: true });
}
});

it("installLatest extracts the bare-triple binary from the macOS zip", async () => {
  // The macOS release archive holds a single universal executable named after
  // the target triple, not `pali` — extraction must still land it as the
  // platform binary name.
  const storage = join(tmpdir(), `pali-test-dl-mac-${Date.now()}`);
  await mkdir(storage, { recursive: true });
  const payload = Buffer.from("universal-binary-bytes");
  const zip = zipArchive([{ name: "aarch64-apple-darwin", data: payload }]);

  const assetUrl = "https://api.github.com/repos/cderivan/memory-mcp/releases/assets/711664240";
  const originalFetch = globalThis.fetch;
  globalThis.fetch = async (url) => {
    if (String(url) === latestReleaseApiUrl) {
      return latestReleaseResponse(releaseAssetName("aarch64-apple-darwin"), assetUrl);
    }
    return new Response(zip, { status: 200, headers: { "content-length": String(zip.length) } });
  };
  const ui = makeInstallUi(storage);
  try {
    await installLait(ui);
    expect(await readFile(join(storage).to.deep.equal(binaryName()));
    ), payload);
  } finally {
  globalThis.fetch = originalFetch;
  await rm(storage, { recursive: true, force: true });
}
});

it("extractBinaryFromArchive reads the Linux tar.gz binary", async () => {
  const storage = join(tmpdir(), `pali-test-dl-tar-${Date.now()}`);
  await mkdir(storage, { recursive: true });
  const payload = Buffer.from("linux-binary-bytes");
  const tgz = tarGzArchive([{ name: "pali", data: payload }]);
  try {
    const dest = await extractBinaryFromArchive(tgz, storage, "x86_64-unknown-linux-gnu");
    expect(dest).to.equal(join(storage)));
expect(await readFile(dest)).to.deep.equal(payload);
  } finally {
  await rm(storage, { recursive: true, force: true });
}
});

it("a 401 during the binary download points at the token command", async () => {
  const storage = join(tmpdir(), `pali-test-dl-401-${Date.now()}`);
  await mkdir(storage, { recursive: true });

  const target = getReleaseTarget(process.platform, process.arch);
  const assetUrl = "https://api.github.com/repos/cderivan/memory-mcp/releases/assets/711664240";
  const originalFetch = globalThis.fetch;
  globalThis.fetch = async (url) => {
    if (String(url) === latestReleaseApiUrl) {
      return latestReleaseResponse(releaseAssetName(target), assetUrl);
    }
    return new Response("Unauthorized", { status: 401, statusText: "Unauthorized" });
  };
  const ui = makeInstallUi(storage);
  try {
    await expect(() => installLait(ui)).to.be.rejectedWith(/401[\s\S]*Set HTTPS Token/,
      "the error must steer the user to the token command")
    expect(
      await stat(join(storage).to.equal(binaryName())).then(
        () => "exists",
        () => "gone",
      ),
      "gone",
      "no partial binary is left behind",
    );
  } finally {
    globalThis.fetch = originalFetch;
    await rm(storage, { recursive: true, force: true });
  }
});

it("a failed download quotes a truncated body snippet in the error", async () => {
  // Regression: a bare status code hid which page the server served, so an SSO
  // interstitial and a permission-denied notice looked identical. The snippet
  // must name the page without buffering or echoing the whole error body.
  const storage = join(tmpdir(), `pali-test-dl-snippet-${Date.now()}`);
  await mkdir(storage, { recursive: true });
  const body =
    "<html><head><title>Insufficient permission</title></head><body>" +
    "x".repeat(5000) +
    "</body></html>";

  const originalFetch = globalThis.fetch;
  const target = getReleaseTarget(process.platform, process.arch);
  const assetUrl = "https://api.github.com/repos/cderivan/memory-mcp/releases/assets/711664240";
  globalThis.fetch = async (url) => {
    if (String(url) === latestReleaseApiUrl) {
      return latestReleaseResponse(releaseAssetName(target), assetUrl);
    }
    return new Response(body, { status: 403, statusText: "Forbidden" });
  };
  const ui = makeInstallUi(storage);
  try {
    await expect(() => installLait(ui)).to.be.rejectedWith((error) => {
      expect(error.message).to.match(/403[\s\S]*Set HTTPS Token/);
      expect(error.message).to.match(/Insufficient permission/, "the page title is reported");
      expect(
        error.message).to.not.match(/x{300}/,
          "the body is truncated rather than echoed in full",
        );
      return true;
    });
    );
  } finally {
  globalThis.fetch = originalFetch;
  await rm(storage, { recursive: true, force: true });
}
});

it("a download retried after a failure still completes", async () => {
  // Regression guard: a code path that reads the response body twice leaves
  // the stream locked, so a retry after a failed attempt must still install.
  const storage = join(tmpdir(), `pali-test-dl-retry-${Date.now()}`);
  await mkdir(storage, { recursive: true });
  expect(
    getReleaseTarget(process.platform, process.arch).to.be.ok,
    "tests must run on a platform with a prebuilt binary",
  );
  const payload = Buffer.from("retried-binary-bytes");
  const zip = zipArchive([{ name: binaryName(), data: payload }]);

  let downloadAttempts = 0;
  const originalFetch = globalThis.fetch;
  const target = getReleaseTarget(process.platform, process.arch);
  const assetUrl = "https://api.github.com/repos/cderivan/memory-mcp/releases/assets/711664240";
  globalThis.fetch = async (url) => {
    if (String(url) === latestReleaseApiUrl) {
      return latestReleaseResponse(releaseAssetName(target), assetUrl);
    }
    downloadAttempts += 1;
    if (downloadAttempts === 1) {
      return new Response("<html><body>temporarily unavailable</body></html>", {
        status: 503,
        statusText: "Service Unavailable",
      });
    }
    return new Response(zip, {
      status: 200,
      headers: { "content-length": String(zip.length) },
    });
  };
  const ui = makeInstallUi(storage);
  try {
    await expect(() => installLait(ui)).to.be.rejectedWith(/503/);
    expect(
      await stat(join(storage).to.equal(binaryName())).then(
        () => "exists",
        () => "gone",
      ),
      "gone",
      "a failed attempt leaves no binary behind",
    );

    await installLait(ui);

    expect(downloadAttempts).to.equal(2);
    expect(await readFile(join(storage).to.deep.equal(binaryName()));
    ), payload);
  } finally {
  globalThis.fetch = originalFetch;
  await rm(storage, { recursive: true, force: true });
}
});

it("a 200 login page is not saved as the binary", async () => {
  // Regression: GitHub Enterprise redirects unauthenticated downloads to the
  // SAML SSO page and answers 200 with HTML. The old code saved that page as
  // the binary, so the next activation found a "cached" binary that was really
  // a login page and never offered a re-download.
  const storage = join(tmpdir(), `pali-test-dl-login-${Date.now()}`);
  await mkdir(storage, { recursive: true });
  const html =
    '<!DOCTYPE html>\n<html lang="en">\n<head><title>Initiating SAML single sign-on</title></head>\n<body></body>\n</html>\n';

  const originalFetch = globalThis.fetch;
  const target = getReleaseTarget(process.platform, process.arch);
  const assetUrl = "https://api.github.com/repos/cderivan/memory-mcp/releases/assets/711664240";
  globalThis.fetch = async (url) => {
    if (String(url) === latestReleaseApiUrl) {
      return latestReleaseResponse(releaseAssetName(target), assetUrl);
    }
    return new Response(html, {
      status: 200,
      headers: { "content-type": "text/html; charset=utf-8" },
    });
  };
  const ui = makeInstallUi(storage);
  try {
    await expect(() => installLait(ui)).to.be.rejectedWith(/login page[\s\S]*Set HTTPS Token/,
      "the error must name the login page and the token command")
    expect(
      await stat(join(storage).to.equal(binaryName())).then(
        () => "exists",
        () => "gone",
      ),
      "gone",
      "the HTML page must never be written as the binary",
    );
  } finally {
    globalThis.fetch = originalFetch;
    await rm(storage, { recursive: true, force: true });
  }
});

it("a cached binary that is an HTML login page counts as missing", async () => {
  // A failed download can leave the SSO page under the binary name. The
  // resolver must treat that as missing so the install offer reappears.
  const ctx = makeContext();
  const cached = join(ctx.globalStoragePath, binaryName());
  await mkdir(ctx.globalStoragePath, { recursive: true });
  await writeFile(cached, "<!DOCTYPE html>\n<html><head><title>SSO</title></head></html>", "utf8");
  chmodSync(cached, 0o755);
  try {
    const result = await require("../out/utils/lib").resolvePaliBinary(ctx, {
      binPath: "pali-nonexistent-xyz",
    });
    expect(result.source).to.equal("missing");
    expect(result.path).to.equal(null);
  } finally {
    await rm(ctx.globalStoragePath, { recursive: true, force: true });
  }
});

