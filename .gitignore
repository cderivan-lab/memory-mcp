openspec/.cache/
# Machine-local tool state.
.freebuff/
**/node_modules/**
*.vsix
.DS_Store
.vscode-test/
tsconfig.tsbuildinfo
# node --experimental-test-coverage output.
coverage/


# vscode-extension-tester downloads its VS Code and ChromeDriver here.
test-resources/

