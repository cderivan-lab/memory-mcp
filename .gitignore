.codegraph/
/target
# Local MCP client config (machine-specific command path and remote host).
.vscode/mcp.json
# Written by the extension's hook installer with absolute local paths.
.github/hooks/pali.json
.memory-mcp-index/
# Embedding model artifacts (ADR-0049). The extension's installer downloads
# models/bge-small-en-v1.5.zip, which is the one file that has to be committed.
# Unpacked weights (~133 MB) exceed the remote's 100 MB per-file limit, and the
# per-file copies are regenerable with scripts/fetch-model.sh, so only the
# archive is tracked.
models/*
!models/bge-small-en-v1.5.zip
