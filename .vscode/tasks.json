// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install dependencies",
			"type": "shell",
			"command": "npm ci",
			"inAgents": true,
			"runOptions": {
				"runOn": "worktreeCreated"
			}
		},
		{
			"label": "Watch extension build",
			"type": "npm",
			"script": "watch",
			"inAgents": true,
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
